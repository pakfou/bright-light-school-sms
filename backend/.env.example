# ==========================================
# BLS School Management System - Environment Config
# ==========================================

# Server Port (Auto-injected by Google Cloud Run / Render)
PORT=5000

# Database Configuration (MySQL / MariaDB / Cloud SQL / TiDB / Aiven / Railway)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=bls_school_db
DB_PORT=3306

# Enable SSL for cloud database services (Set to true for TiDB, Aiven, PlanetScale, Cloud SQL)
DB_SSL=false

# Optional Gemini AI API Key for BLS Smart AI Assistant
# GEMINI_API_KEY=your_gemini_api_key_here
