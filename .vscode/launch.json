{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Chrome",
      "port": 9222,
      "request": "attach",
      "type": "chrome",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Flutter Web (Chrome)",
      "request": "launch",
      "type": "dart",
      "args": [
        "-d",
        "chrome"
      ]
    },
    {
      "name": "Flutter Windows Desktop",
      "request": "launch",
      "type": "dart",
      "args": [
        "-d",
        "windows"
      ]
    }
  ]
}